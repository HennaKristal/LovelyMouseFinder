<?xml version="1.0"?>
<Plugin>
    <Information>
        <Name>Lovely Mouse Finder</Name>
        <Author>LovelyMouseFinder</Author>
        <Version>1.10</Version>
        <Description>Draws a heart shape around the mouse cursor for easier mouse detection.</Description>
    </Information>
    <Package>LovelyMouseFinder.LovelyMouseFinder</Package>
    <Configuration Apartment="LovelyMouseFinder" />
</Plugin>
